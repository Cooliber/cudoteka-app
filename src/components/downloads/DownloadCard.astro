---
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'downloads'>;
}

const { item } = Astro.props;
const { title, description, fileSize, icon, category, slug } = item.data;

const categoryLabels: Record<string, string> = {
  sezony: 'Pory roku',
  artykulacja: 'Artykulacja',
  logopedia: 'Logopedia',
  wakacje: 'Wyzwania wakacyjne',
  inne: 'Inne',
};

const categoryAccents: Record<string, string> = {
  sezony: 'var(--gold)',
  artykulacja: 'var(--blue)',
  logopedia: 'var(--mint)',
  wakacje: 'var(--peach)',
  inne: 'var(--gold)',
};
---

<article class="download-card" style={`--accent: ${categoryAccents[category]}`}>
  <header class="card-head">
    <span class="card-icon" aria-hidden="true">{icon}</span>
    <span class="card-tag">{categoryLabels[category]}</span>
  </header>
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>
  <footer class="card-foot">
    <span class="card-size">PDF · {fileSize}</span>
    <a
      class="card-link"
      href={`/materialy/${slug}/`}
      aria-label={`Zobacz i pobierz: ${title} (PDF, ${fileSize})`}
    >
      <span>Zobacz i pobierz</span>
    </a>
  </footer>
</article>

<style>
  /* The card is four subgrid rows: head, title, description, footer. Cards in
     one row share the row sizes, so titles and footers line up whatever the
     text length. */
  .download-card {
    --accent: var(--gold);
    --accent-ink: color-mix(in srgb, var(--accent), var(--ink) 55%);
    --accent-soft: color-mix(in srgb, var(--accent) 16%, transparent);

    position: relative;
    isolation: isolate;
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0.55rem;

    padding: 1.5rem;
    background: oklch(100% 0 none);
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    border-radius: 1.5rem;
  }

  /* Hover shadow as a separate layer: fading opacity repaints nothing. */
  .download-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    box-shadow: 0 22px 40px -20px color-mix(in srgb, var(--blue-deep) 55%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .download-card:hover {
      translate: 0 -3px;
    }

    .download-card:hover::before {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .download-card {
      transition: translate 0.3s var(--ease-out, ease-out);
    }

    .download-card::before {
      transition: opacity 0.3s var(--ease-out, ease-out);
    }
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .card-icon {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 0.9rem;
    background: var(--accent-soft);
    font-size: 1.35rem;
    line-height: 1;
  }

  .card-tag {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    color: var(--accent-ink);
  }

  .card-title {
    font-size: 1.18rem;
    margin-block-start: 0.35rem;
    text-wrap: balance;
  }

  .card-desc {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
    padding-block-start: 0.9rem;
    border-block-start: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .card-size {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 2.75rem;
    padding-block: 0.6rem;
    padding-inline: 1.15rem;
    border-radius: 999px;
    background: var(--blue-deep);
    color: oklch(100% 0 none);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  .card-link > span {
    text-box: trim-both cap alphabetic;
  }

  .card-link:active {
    scale: 0.97;
  }

  @media (hover: hover) and (pointer: fine) {
    .card-link:hover {
      background: var(--blue);
      translate: 0 -1px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .card-link {
      transition:
        translate 0.2s var(--ease-out, ease-out),
        scale 0.16s var(--ease-out, ease-out),
        background-color 0.2s ease;
    }
  }

  /* One link per card carries the destination; its overlay makes the whole
     card clickable, and the ring is drawn on the card instead. */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card-link:focus-visible {
    outline: 2px solid transparent;
  }

  .download-card:has(.card-link:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>
