---
interface Props {
  href: string;
  fileSize?: string;
  label?: string;
  ariaLabel?: string;
  delayMs?: number;
}

const { href, fileSize, label = 'Pobierz PDF', ariaLabel, delayMs = 3000 } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const clipId = `delivery-clip-${uid}`;
---

<div class="hook" data-hook data-delay={delayMs}>
  <div class="hook-scene">
    <svg class="hook-art" viewBox="0 0 640 380" fill="none" aria-hidden="true">
      <defs><clipPath id={clipId}><rect width="640" height="280"></rect></clipPath></defs>
      <g data-props></g>
      <g data-debris></g>
      <g data-worker opacity="0" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path data-spine></path>
        <path data-arms></path>
        <path data-legs></path>
        <g data-expression>
          <circle cy="-62" r="8" fill="var(--scene-bg, #fff)"></circle>
          <circle cx="-3" cy="-64" r=".8" fill="currentColor" stroke="none"></circle>
          <circle cx="2" cy="-64" r=".8" fill="currentColor" stroke="none"></circle>
          <path d="M-3-59q3 2 6 0" stroke-width="1"></path>
        </g>
        <path data-tool></path>
        <g data-hand opacity="0">
          <path d="M-3 2V-6L1-11V-18Q1-21 4-20Q7-19 6-15L5-10H12Q15-10 14-6L12 1Q12 3 9 3H1Z" fill="currentColor" stroke-width="1.2"></path>
          <path d="M0-5V1M7-6H12" stroke="var(--scene-bg, #fff)" stroke-width="1.2"></path>
        </g>
      </g>
      <g data-front></g>
    </svg>
    <a
      class="hook-control"
      data-trigger
      href={href}
      download
      aria-label={ariaLabel ?? `${label}${fileSize ? ` (PDF, ${fileSize})` : ' (PDF)'}`}
    >
      <span data-control-label>{label}</span>
    </a>
  </div>
  <div class="hook-foot">
    <p class="hook-caption" data-caption>No dalej - ściągnij plik!</p>
    <button class="hook-sound" data-sound type="button" aria-pressed="true">
      <span data-sound-label>Dźwięk: włączony</span>
    </button>
  </div>
  <span class="visually-hidden" role="status" aria-live="polite" data-live></span>
</div>

<style>
  .hook {
    display: flex;
    flex-direction: column;
    gap: 14px;
    inline-size: 100%;
  }

  .hook-scene {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 640 / 380;
    overflow: hidden;
    background: #fff;
    --scene-bg: #fff;
    color: var(--ink);
  }

  .hook-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .hook-control {
    position: absolute;
    left: 34.375%;
    top: 73.684%;
    width: 31.25%;
    height: 12.632%;
    min-block-size: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: 0;
    padding-inline: 0.75rem;
    border: 0;
    border-radius: 999px;
    background: var(--blue-deep);
    color: oklch(100% 0 none);
    font-family: inherit;
    font-weight: 800;
    font-size: clamp(0.8rem, 2.2vw, 0.95rem);
    line-height: 1;
    white-space: nowrap;
    z-index: 2;
  }

  .hook-control > span {
    text-box: trim-both cap alphabetic;
  }

  .hook-control:active {
    scale: 0.97;
  }

  .hook-control[aria-disabled="true"] {
    cursor: progress;
  }

  .hook-control:focus-visible,
  .hook-sound:focus-visible {
    outline: max(2px, 0.08em) solid currentColor;
    outline-offset: 0.25em;
  }

  @media (hover: hover) and (pointer: fine) {
    .hook-control:hover {
      background: var(--blue);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hook-control {
      transition: background-color 0.2s ease, scale 0.16s ease;
    }
  }

  .hook-foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px 16px;
    flex-wrap: wrap;
  }

  .hook-caption {
    margin: 0;
    min-block-size: 1.5em;
    font-family: "Fraunces", Georgia, serif;
    font-style: italic;
    font-size: 0.98rem;
    color: var(--ink-soft);
    text-align: center;
  }

  .hook-sound {
    display: inline-flex;
    align-items: center;
    min-block-size: 2rem;
    padding-block: 0.3rem;
    padding-inline: 0.85rem;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .hook-sound:hover {
      color: var(--ink);
      border-color: color-mix(in srgb, var(--ink) 30%, transparent);
    }
  }

  .hook-sound[aria-pressed="false"] {
    opacity: 0.72;
  }

  @media print {
    .hook {
      display: none;
    }
  }
</style>

<script>
  class OddlyFoley {
    constructor() {
      this.context = null;
      this.voices = new Set();
    }
    start() {
      this.context ??= new (window.AudioContext || window.webkitAudioContext)();
      if (!this.master) {
        this.master = this.context.createGain();
        this.master.gain.value = 2;
        this.master.connect(this.context.destination);
      }
      this.context.resume().catch(() => {});
    }
    stop() {
      for (const source of this.voices) {
        try {
          source.stop();
        } catch {}
      }
      this.voices.clear();
    }
    close() {
      this.stop();
      this.context?.close().catch(() => {});
      this.context = null;
      this.master = null;
    }
    layer({ duration = 0.1, volume = 0.1, frequency = 800, end = frequency, delay = 0, noise = true, q = 0.7, attack = 0.004, pulse = 0 }) {
      const c = this.context;
      if (!c || c.state !== 'running') return;
      const at = c.currentTime + delay;
      const g = c.createGain();
      const f = c.createBiquadFilter();
      let s;
      if (noise) {
        s = c.createBufferSource();
        const b = c.createBuffer(1, Math.ceil(c.sampleRate * duration), c.sampleRate);
        const d = b.getChannelData(0);
        for (let i = 0; i < d.length; i++) {
          const t = i / c.sampleRate;
          d[i] = (Math.random() * 2 - 1) * (pulse ? 0.3 + 0.7 * Math.pow(Math.sin(t * pulse * Math.PI), 2) : 1);
        }
        s.buffer = b;
      } else {
        s = c.createOscillator();
        s.type = 'sine';
        s.frequency.setValueAtTime(frequency, at);
        s.frequency.exponentialRampToValueAtTime(end, at + duration);
      }
      f.type = noise ? 'bandpass' : 'lowpass';
      f.Q.value = q;
      f.frequency.setValueAtTime(noise ? frequency : 1800, at);
      if (noise) f.frequency.exponentialRampToValueAtTime(end, at + duration);
      g.gain.setValueAtTime(0, at);
      g.gain.linearRampToValueAtTime(volume, at + Math.min(attack, duration * 0.4));
      g.gain.exponentialRampToValueAtTime(0.0001, at + duration);
      s.connect(f).connect(g).connect(this.master);
      this.voices.add(s);
      s.onended = () => {
        this.voices.delete(s);
        s.disconnect();
        f.disconnect();
        g.disconnect();
      };
      s.start(at);
      s.stop(at + duration);
    }
    play(name) {
      const n = (duration, volume, frequency, end = frequency, extra = {}) => this.layer({ duration, volume, frequency, end, ...extra });
      const thud = (v = 0.22) => {
        n(0.16, v, 95, 42, { noise: false });
        n(0.065, v * 0.6, 320);
      };
      switch (name) {
        case 'step':
          n(0.055, 0.075, 520);
          break;
        case 'cast':
          n(0.27, 0.15, 550, 2800, { attack: 0.07 });
          n(0.18, 0.055, 3300, 1600, { delay: 0.06, pulse: 60 });
          break;
        case 'metal':
          n(0.12, 0.065, 1800, 1550, { noise: false });
          n(0.07, 0.04, 2900, 2650, { noise: false });
          n(0.02, 0.13, 3500);
          break;
        case 'rope':
          n(0.38, 0.105, 650, 1100, { pulse: 32, q: 1.5 });
          n(0.3, 0.035, 230, 310, { q: 7, pulse: 45 });
          break;
        case 'release':
          n(0.04, 0.18, 1300);
          n(0.13, 0.075, 600, 180);
          break;
        case 'air':
          n(0.4, 0.12, 700, 2400, { attack: 0.14 });
          break;
        case 'heavy':
          thud(0.32);
          n(0.25, 0.1, 180, 80);
          break;
      }
    }
  }

  const DURATION = 8.4;
  const SOUNDS = [
    [0.3, 'step'],
    [1.24, 'cast'],
    [2.2, 'metal'],
    [2.35, 'rope'],
    [3.38, 'cast'],
    [3.95, 'metal'],
    [4.25, 'rope'],
    [4.8, 'rope'],
    [5.35, 'rope'],
    [5.85, 'release'],
    [5.92, 'air'],
    [6.28, 'heavy'],
  ];

  const clamp = (x) => Math.min(1, Math.max(0, x));
  const lerp = (a, b, t) => a + (b - a) * t;
  const phase = (t, a, b) => clamp((t - a) / (b - a));
  const ease = (x) => {
    x = clamp(x);
    return x * x * (3 - 2 * x);
  };
  const fade = (t, a, b, c, d) => ease(phase(t, a, b)) * (1 - ease(phase(t, c, d)));
  const set = (el, key, value) => el.setAttribute(key, value);
  const svgPath = (d, extra = '') => `<path d="${d}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" ${extra}/>`;
  const fileGlyph = (x, y, rotate = 0) =>
    `<g transform="translate(${x} ${y}) rotate(${rotate})">${svgPath('M-18 1L6 0l13 12-1 35-37-1Z', 'style="fill:var(--scene-bg,#fff)"')}${svgPath('M6 0l1 12h12M-10 26l19 1M-10 33l14 1')}</g>`;

  const rig = {
    windup: [18, -49, 6, -25, 35, -59, 42, -72, 2, -37, -10, -29, -7, -13, -22, 0, 19, -12, 26, 0],
    overhead: [2, -56, 1, -27, 14, -76, -8, -89, -7, -39, -15, -30, -13, -14, -25, 0, 16, -13, 27, 0],
    release: [-12, -53, -5, -27, -31, -65, -46, -74, -10, -36, -4, -26, -19, -13, -28, 0, 13, -15, 27, 0],
    follow: [-20, -43, -7, -25, -39, -42, -54, -32, -12, -30, 0, -25, -20, -12, -28, 0, 11, -14, 27, -3],
    haul: [14, -43, 20, -24, -3, -37, -28, -48, 1, -29, -27, -45, 1, -13, -18, 0, 25, -12, 35, 0],
    stand: [0, -50, 0, -26, -12, -37, -12, -25, 12, -37, 12, -25, -7, -12, -13, 0, 7, -12, 13, 0],
    spent: [-5, -38, 2, -22, -14, -24, -17, -13, 9, -24, 14, -13, -5, -10, -13, 0, 12, -10, 20, 0],
    flat: [28, -8, 5, -5, 17, -2, 35, 0, 23, -14, 35, -19, -8, -5, -20, 0, -7, -1, -23, 0],
    wave: [0, -50, 0, -26, -12, -37, -12, -25, 17, -43, 19, -61, -7, -12, -13, 0, 7, -12, 13, 0],
  };

  function bentLimb(ax, ay, bx, by, cx, cy) {
    const before = [lerp(bx, ax, 0.15), lerp(by, ay, 0.15)];
    const after = [lerp(bx, cx, 0.15), lerp(by, cy, 0.15)];
    return `M${ax} ${ay}L${before[0]} ${before[1]}Q${bx} ${by} ${after[0]} ${after[1]}L${cx} ${cy}`;
  }

  const foley = new OddlyFoley();
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const disposers = [];

  document.querySelectorAll('[data-hook]').forEach((root) => init(root));
  window.addEventListener('pagehide', () => {
    for (const dispose of disposers) dispose();
    disposers.length = 0;
    foley.close();
  });

  function init(root) {
    const q = (s) => root.querySelector(s);
    const clipId = q('[id^="delivery-clip-"]').id;
    const trigger = q('[data-trigger]');
    const caption = q('[data-caption]');
    const live = q('[data-live]');
    const props = q('[data-props]');
    const front = q('[data-front]');
    const debris = q('[data-debris]');
    const worker = q('[data-worker]');
    const label = q('[data-control-label]');
    const sound = q('[data-sound]');
    const soundLabel = q('[data-sound-label]');

    let busy = false;
    let raf = 0;
    let audible = true;
    let previous = 0;
    let sceneTime = -1;
    let downloaded = false;
    let downloadTimer = 0;
    const delayMs = Number(root.dataset.delay || 3000);

    const cape = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    cape.setAttribute('fill', '#ff565d');
    cape.setAttribute('stroke', 'none');
    worker.prepend(cape);
    worker.setAttribute('stroke-width', '2.2');

    const expression = q('[data-expression]');
    expression.innerHTML =
      '<ellipse cy="-66" rx="12" ry="11.5" fill="var(--scene-bg,#fff)"/><path d="" data-comic-mouth stroke-width="1.6"/><path data-comic-eyes stroke-width="1.7"/><path data-comic-brows stroke-width="1.3"/>';
    const palms = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    worker.insertBefore(palms, q('[data-hand]'));
    const marks = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    marks.setAttribute('fill', 'none');
    marks.setAttribute('stroke-width', '1.3');
    worker.append(marks);

    const ground = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    ground.setAttribute('d', 'M161 329q75-2 147 0m9 0 66 1m8-1 72-1');
    ground.setAttribute('stroke', 'currentColor');
    ground.setAttribute('stroke-width', '.8');
    ground.setAttribute('opacity', '0');
    props.parentNode.insertBefore(ground, props);

    function actor(x, y, pose = 'stand', alpha = 1, rotation = 0, blend = null, f = 0) {
      const a = rig[pose];
      const v = blend ? a.map((n, i) => lerp(n, rig[blend][i], ease(f))) : [...a];
      const time = Math.max(0, sceneTime);
      const effort = ['haul'].includes(pose);
      const flutter = Math.sin(time * 8 - 1) * 3;
      const trail = pose === 'hang' ? 9 : pose === 'flat' ? 1 : 4;
      set(
        cape,
        'd',
        `M${v[0]} ${v[1] + 1}C${v[0] - 13} ${v[1] + 4 - trail} ${v[0] - 28} ${v[1] + 6 + flutter} ${v[0] - 39} ${v[1] + 15 + flutter}L${v[0] - 29} ${v[1] + 19 + flutter}Q${v[0] - 27} ${v[1] + 28} ${v[0] - 22} ${v[1] + 26}Q${v[0] - 9} ${v[1] + 21} ${v[0]} ${v[1] + 1}Z`
      );
      set(palms, 'opacity', 1);
      set(worker, 'data-pose', pose);
      set(worker, 'opacity', alpha);
      set(worker, 'transform', `translate(${x} ${y}) rotate(${rotation})`);
      set(q('[data-spine]'), 'd', `M${v[0]} ${v[1] - 5}Q${v[0] + 3} ${v[1] + 11} ${v[2]} ${v[3]}`);
      set(q('[data-arms]'), 'd', bentLimb(v[0], v[1], ...v.slice(4, 8)) + bentLimb(v[0], v[1], ...v.slice(8, 12)));
      set(
        q('[data-legs]'),
        'd',
        bentLimb(v[2], v[3], ...v.slice(12, 16)) + `q-3-2-7 0q-2 2 7 2` + bentLimb(v[2], v[3], ...v.slice(16, 20)) + `q4-2 7 1q1 2-7 1`
      );
      palms.innerHTML =
        `<circle cx="${v[6]}" cy="${v[7]}" r="2.3" fill="var(--scene-bg,#fff)" stroke-width="1.5"/>` +
        (pose === 'wave' ? '' : `<circle cx="${v[10]}" cy="${v[11]}" r="2.3" fill="var(--scene-bg,#fff)" stroke-width="1.5"/>`);
      set(expression, 'transform', `translate(${v[0] + 7} ${v[1] + 50}) rotate(${pose === 'spent' ? 10 : 0} 0 -66)`);
      const mouth =
        effort
          ? 'M-5-60q5-5 10 0'
          : pose === 'spent'
            ? 'M-5-59q4-2 9 0'
            : pose === 'flat'
              ? 'M-4-60h8'
              : pose === 'wave'
                ? 'M-5-62q5 7 11-1'
                : 'M-4-61q4 3 8 0';
      set(q('[data-comic-mouth]'), 'd', mouth);
      set(
        q('[data-comic-eyes]'),
        'd',
        effort
          ? 'M-7-70l4 2-4 2m14-4-4 2 4 2'
          : pose === 'flat'
            ? 'M-7-71l5 5m0-5-5 5m9-5 5 5m0-5-5 5'
            : 'M-5-69v1m9-1v1'
      );
      set(q('[data-comic-brows]'), 'd', effort ? 'M-8-74l5 2m6 0 5-2' : pose === 'spent' ? 'M-8-73l5 2m6 0 5-2' : '');
      const hx = v[0];
      const hy = v[1] - 16;
      set(marks, 'd', effort ? `M${hx - 18} ${hy - 7}q-5-4-4 1q2 3 4-1m2 9q-6-1-4 3q3 1 4-3` : pose === 'flat' ? `M${hx - 18} ${hy - 7}l-4-4m7-2-1-5m30 5 4-4` : '');
      set(q('[data-tool]'), 'd', '');
      set(q('[data-hand]'), 'opacity', pose === 'wave' ? 1 : 0);
      set(q('[data-hand]'), 'transform', `translate(${v[10]} ${v[11]}) scale(.7)`);
      set(ground, 'opacity', sceneTime >= 0 ? 0.25 * alpha : 0);
      set(ground, 'transform', 'translate(0 -1)');
      return v;
    }

    function hangFile(fy) {
      return `${svgPath('M268 105h104M273 105l-6-8m22 8-6-8m22 8-6-8m22 8-6-8m22 8-6-8m22 8-6-8', 'opacity=".65"')}<g clip-path="url(#${clipId})">${fileGlyph(320, fy)}${svgPath(`M313 ${fy + 46}v7a7 7 0 0 0 14 0v-7`, 'stroke-width="2"')}</g>`;
    }

    function idle() {
      sceneTime = 0;
      front.innerHTML = '';
      debris.innerHTML = '';
      props.innerHTML = hangFile(108);
      actor(449, 328, 'stand', 1, 0, null, 0);
      set(worker, 'data-effort', 'moving');
      caption.textContent = 'No dalej - ściągnij plik!';
    }

    function ceiling(t) {
      sceneTime = t;
      front.innerHTML = '';
      props.innerHTML = '';
      if (t < 0) {
        idle();
        return;
      }
      let x = lerp(411, 449, ease(phase(t, 0, 0.5)));
      const y = 328;
      let pose = 'stand';
      let next = null;
      let f = 0;
      if (t >= 0.5 && t < 0.9) {
        pose = 'stand';
        next = 'windup';
        f = phase(t, 0.5, 0.9);
      } else if (t >= 0.9 && t < 1.04) pose = 'windup';
      else if (t >= 1.04 && t < 1.15) {
        pose = 'windup';
        next = 'overhead';
        f = phase(t, 1.04, 1.15);
      } else if (t >= 1.15 && t < 1.24) {
        pose = 'overhead';
        next = 'release';
        f = phase(t, 1.15, 1.24);
      } else if (t >= 1.24 && t < 1.48) {
        pose = 'release';
        next = 'follow';
        f = phase(t, 1.24, 1.48);
      } else if (t >= 1.48 && t < 1.75) pose = 'follow';
      else if (t >= 1.75 && t < 2.7) {
        pose = 'follow';
        next = 'spent';
        f = phase(t, 1.75, 2.35);
      } else if (t >= 2.7 && t < 3.05) {
        pose = 'spent';
        next = 'windup';
        f = phase(t, 2.7, 3.05);
      } else if (t >= 3.05 && t < 3.2) pose = 'windup';
      else if (t >= 3.2 && t < 3.29) {
        pose = 'windup';
        next = 'overhead';
        f = phase(t, 3.2, 3.29);
      } else if (t >= 3.29 && t < 3.38) {
        pose = 'overhead';
        next = 'release';
        f = phase(t, 3.29, 3.38);
      } else if (t >= 3.38 && t < 3.65) {
        pose = 'release';
        next = 'follow';
        f = phase(t, 3.38, 3.65);
      } else if (t >= 3.65 && t < 3.95) pose = 'follow';
      else if (t >= 3.95 && t < 4.2) {
        pose = 'follow';
        next = 'haul';
        f = phase(t, 3.95, 4.2);
      } else if (t >= 4.2 && t < 5.85) {
        pose = 'haul';
        x += ease(phase(t, 4.2, 5.8)) * 14 + Math.sin(t * 65) * 0.6;
      } else if (t >= 5.85 && t < 6.3) {
        pose = 'haul';
        next = 'flat';
        f = phase(t, 5.85, 6.3);
        x = lerp(463, 480, ease(f));
      } else if (t >= 6.3 && t < 6.8) {
        x = 480;
        pose = 'flat';
      } else if (t >= 6.8 && t < 7.2) {
        x = 480;
        pose = 'flat';
        next = 'spent';
        f = phase(t, 6.8, 7.2);
      } else if (t >= 7.2) {
        x = 480;
        pose = 'wave';
      }
      const v = actor(x, y, pose, fade(t, 0, 0.25, 7.85, 8.35), 0, next, f);
      const hand = { x: x + v[6], y: y + v[7] };
      const drop = phase(t, 5.85, 6.28);
      const fy = 108 + (t > 4.2 && t < 5.85 ? Math.sin(t * 22) * 1.8 : 0) + 210 * drop * drop;
      let hook = { ...hand };
      let sag = 12;
      let rotation = 0;
      if (t >= 1.24 && t < 2.2) {
        const q2 = phase(t, 1.24, 2.2);
        hook = { x: lerp(403, 386, q2) - Math.sin(q2 * Math.PI) * 143, y: lerp(254, 320, q2) - Math.sin(q2 * Math.PI) * 172 };
        sag = 35;
        rotation = q2 * 210;
      } else if (t >= 2.2 && t < 2.7) {
        const q2 = ease(phase(t, 2.2, 2.7));
        hook = { x: lerp(386, hand.x, q2), y: lerp(320, hand.y, q2) };
        sag = 25 * (1 - q2);
      } else if (t >= 3.38 && t < 3.95) {
        const q2 = phase(t, 3.38, 3.95);
        hook = { x: lerp(403, 337, q2), y: lerp(254, 176, q2) - Math.sin(q2 * Math.PI) * 68 };
        sag = 24 * (1 - q2);
        rotation = lerp(-80, -180, ease(q2));
      } else if (t >= 3.95) {
        hook = { x: 337, y: fy + 68 };
        rotation = -180;
        sag = 0;
      }
      const ropeHand = t < 3.95 ? { x: x + v[10], y: y + v[11] } : hand;
      const ropeAlpha = fade(t, 0.5, 0.7, 5.95, 6.14);
      if (t < 6.14) {
        props.innerHTML = `<g opacity="${ropeAlpha}">${svgPath(`M${ropeHand.x} ${ropeHand.y}Q${(ropeHand.x + hook.x) / 2} ${(ropeHand.y + hook.y) / 2 + sag} ${hook.x} ${hook.y}`, 'stroke-width="1.2"')}<g transform="translate(${hook.x} ${hook.y}) rotate(${rotation}) scale(.65)"><circle r="2.2" stroke="currentColor" stroke-width="1.6" fill="var(--scene-bg,#fff)"/>${svgPath('M0 2.2V16Q0 26 13 26T26 12V8l-5 6', 'stroke-width="1.8"')}</g></g>`;
      }
      props.innerHTML += `<g opacity="${fade(t, 0.35, 0.6, 6.1, 6.4)}">${hangFile(fy)}</g>`;
      if (t >= 3.95 && t < 4.08) front.innerHTML = svgPath('M304 161l-5 3m34-4 6 3M319 174v5');
      label.textContent = t < 3.95 ? 'Łapię…' : t < 5.85 ? 'Ciągniemy…' : t < 6.3 ? 'Prawie mam!' : 'Mam!';
      caption.textContent =
        t < 1.24
          ? 'Ma plan.'
          : t < 2.2
            ? 'No, prawie…'
            : t < 3.38
              ? 'To był rzut rozgrzewkowy.'
              : t < 3.95
                ? 'Jeszcze jedna próba.'
                : t < 4.3
                  ? 'Mam go!'
                  : t < 5.85
                    ? 'Jeszcze. Troszeczkę. Ciągniemy.'
                    : t < 7.2
                      ? 'Plik uratowany. Duma lekko nadszarpnięta.'
                      : 'Udało się. W końcu!';
    }

    function setBusy(value) {
      busy = value;
      trigger.setAttribute('aria-disabled', String(value));
      trigger.setAttribute('aria-busy', String(value));
    }

    function startDownload() {
      if (downloaded) return;
      downloaded = true;
      const link = document.createElement('a');
      link.href = trigger.href;
      link.download = trigger.getAttribute('download') ?? '';
      document.body.append(link);
      link.click();
      link.remove();
      live.textContent = 'Pobieranie rozpoczęte.';
    }

    function finish() {
      if (!downloaded) startDownload();
      setBusy(false);
      set(ground, 'opacity', 0);
      set(worker, 'opacity', 0);
      front.innerHTML = '';
      debris.innerHTML = '';
      idle();
      label.textContent = 'Pobierz ponownie';
      caption.textContent = 'Udało się. W końcu! Kliknij, aby pobrać ponownie.';
      live.textContent = 'Animacja zakończona. Możesz pobrać plik ponownie.';
    }

    function play() {
      if (busy) return;
      if (reduce.matches) {
        live.textContent = 'Pobieranie rozpoczęte.';
        return;
      }
      setBusy(true);
      downloaded = false;
      live.textContent = 'Za chwilę rozpocznie się pobieranie.';
      downloadTimer = window.setTimeout(startDownload, delayMs);
      if (audible) {
        try {
          foley.start();
        } catch {
          audible = false;
          updateSound();
        }
      }
      previous = -1;
      const start = performance.now();
      function tick(now) {
        const t = (now - start) / 1000;
        ceiling(t);
        if (audible && foley.context) {
          for (const [at, name] of SOUNDS) if (at > previous && at <= t && t - at < 0.15) foley.play(name);
        }
        previous = t;
        if (t < DURATION) raf = requestAnimationFrame(tick);
        else finish();
      }
      raf = requestAnimationFrame(tick);
    }

    function updateSound() {
      sound.setAttribute('aria-pressed', String(audible));
      soundLabel.textContent = audible ? 'Dźwięk: włączony' : 'Dźwięk: wyłączony';
    }

    trigger.addEventListener('click', (event) => {
      if (reduce.matches) {
        live.textContent = 'Pobieranie rozpoczęte.';
        return;
      }
      event.preventDefault();
      play();
    });
    sound.addEventListener('click', () => {
      audible = !audible;
      updateSound();
      if (audible) {
        try {
          foley.start();
        } catch {
          audible = false;
          updateSound();
        }
      } else {
        foley.stop();
      }
    });

    updateSound();
    idle();
    disposers.push(() => {
      cancelAnimationFrame(raf);
      window.clearTimeout(downloadTimer);
    });
  }
</script>
